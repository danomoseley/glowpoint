#!/bin/sh
# glowpoint pre-push hook: the documentation and all tests must pass before a push.
# Turn it on once in each clone:  git config core.hooksPath .githooks
cd "$(git rev-parse --show-toplevel)" || exit 1
echo "pre-push: checking documentation and tests..."
for t in tests/test_docs.py tests/test_render.py tests/test_calibrate.py tests/test_detect.py; do
    out=$(python3 -W ignore "$t" 2>&1); status=$?
    echo "$out" | grep -E "^(PASS|FAIL)|^      " 
    if [ $status -ne 0 ]; then
        echo "pre-push: $t failed. Update README.md / AGENTS.md or fix the code, then push again."
        exit 1
    fi
done
echo "pre-push: all checks passed."
